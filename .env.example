

# 1. MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://cartnova_user:YourSecurePassword123@cluster0.mongodb.net/cartnova?retryWrites=true&w=majority

# 2. JWT Authentication Secrets
JWT_SECRET=cartnova_trosto_super_secret_jwt_key_2026_change_in_production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=

# 3. Cloudinary CDN (Product Assets & Photography)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 4. Razorpay Payment Gateway (Indian UPI, Cards & NetBanking)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId123
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey123
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret123

# 5. Resend Transactional Email
RESEND_API_KEY=re_YourResendApiKey123
EMAIL_FROM=support@cartnova.com
ADMIN_EMAIL=admin@cartnova.com
